# Copy to .env and fill in. Never commit .env.
# Any *_PASSWORD can instead be given as *_PASSWORD_FILE=/run/secrets/... (Docker secret).

# --- Mailbox (IMAP over TLS, certificate is always verified) ---
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=drucker@example.com
IMAP_PASSWORD=change-me
IMAP_FOLDER=INBOX
# Printed mails are moved here; problems go to ERROR_FOLDER. Created automatically.
# Some servers need a prefix, e.g. INBOX.Gedruckt
DONE_FOLDER=Gedruckt
ERROR_FOLDER=Fehler
POLL_SECONDS=30

# --- Printer (IPP / AirPrint). Common paths: /ipp/print (most), /ipp (some HP) ---
PRINTER_URI=ipp://192.168.1.50:631/ipp/print
# For ipps:// with the printer's self-signed certificate set this to 0
PRINTER_TLS_VERIFY=1
# auto = PDF if the printer lists it, otherwise "application/octet-stream" (printer detects
# the PDF itself; needed e.g. for Xerox C235). Or force one of the two.
PRINTER_FORMAT=auto
COLOR_MODE=color
# one-sided | two-sided-long-edge | two-sided-short-edge
SIDES=one-sided
MEDIA=iso_a4_210x297mm

# --- Limits ---
MAX_MAIL_MB=10
MAX_JOBS_PER_HOUR=20
MAX_TEXT_PAGES=10

# --- Alert mail when more than ALERT_THRESHOLD jobs ran within 60 minutes ---
# (at most one alert per hour). Leave ALERT_TO empty to only log a warning.
ALERT_THRESHOLD=10
ALERT_TO=admin@example.com

# --- Reply to the sender after every mail (printed / partly / not printed) ---
# Only sent when the receiving mail server verified the sender (DMARC, or SPF/DKIM
# matching the From domain), never to automatic mails, bounces or mailing lists.
REPLY_ENABLED=1
MAX_REPLIES_PER_HOUR=30
# Optional, recommended: the first word of the Authentication-Results header that YOUR
# provider adds (open a received mail's source to see it, e.g. "mx.provider.de").
# If empty, the topmost Authentication-Results header is used.
#AUTH_SERVID=
# Sender address of replies; defaults to SMTP_USER / IMAP_USER
#REPLY_FROM=

# --- Outgoing mail (alert + replies) ---
SMTP_HOST=smtp.example.com
# 465 = implicit TLS, 587 = STARTTLS (TLS is required either way)
SMTP_PORT=465
# SMTP_USER / SMTP_PASSWORD / ALERT_FROM default to the IMAP login
#SMTP_USER=
#SMTP_PASSWORD=
#ALERT_FROM=

LOG_LEVEL=INFO
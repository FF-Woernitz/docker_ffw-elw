# Required
GOPRO_BLE_ADDRESS=AA:BB:CC:DD:EE:FF
MQTT_HOST=mqtt

# MQTT
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_TLS=false
CAMERA_ID=cam1
# Default: gopro/<CAMERA_ID>
TOPIC_PREFIX=

# Wi-Fi the camera joins for the live stream
WIFI_SSID=<SSID>
WIFI_PASSWORD=<PSK>

# Live stream
RTMP_URL=rtmp://<IP>/live/cam
STREAM_MIN_KBPS=800
STREAM_MAX_KBPS=4000
STREAM_START_KBPS=2000
# 480, 720 or 1080
STREAM_WINDOW=1080
STREAM_SAVE_TO_SD=true

LOG_LEVEL=INFO
